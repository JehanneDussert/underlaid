{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "underlaid.vercel.app"
        }
      ],
      "destination": "https://underlaid.fr/:path*",
      "permanent": true
    },
    {
      "source": "/fr",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/map",
      "destination": "/carte",
      "permanent": true
    },
    {
      "source": "/map",
      "destination": "/en/map",
      "permanent": true
    },
    {
      "source": "/fr/methodology",
      "destination": "/methode",
      "permanent": true
    },
    {
      "source": "/methodology",
      "destination": "/en/method",
      "permanent": true
    },
    {
      "source": "/fr/methodology/details",
      "destination": "/methode/detail",
      "permanent": true
    },
    {
      "source": "/methodology/details",
      "destination": "/en/method/details",
      "permanent": true
    },
    {
      "source": "/fr/ranking",
      "destination": "/quartiers-les-plus-exposes",
      "permanent": true
    },
    {
      "source": "/ranking",
      "destination": "/en/most-exposed-neighbourhoods",
      "permanent": true
    },
    {
      "source": "/fr/press",
      "destination": "/presse",
      "permanent": true
    },
    {
      "source": "/press",
      "destination": "/en/press",
      "permanent": true
    },
    {
      "source": "/adresse",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/address",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/fr/address",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/address",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/quiz",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/quiz",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/fr/quiz",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/itineraires",
      "destination": "/lieux-du-quotidien",
      "permanent": true
    },
    {
      "source": "/en/routes",
      "destination": "/en/everyday-places",
      "permanent": true
    },
    {
      "source": "/fr/routes",
      "destination": "/lieux-du-quotidien",
      "permanent": true
    },
    {
      "source": "/routes",
      "destination": "/en/everyday-places",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/quartier/:code",
      "destination": "/quartier"
    },
    {
      "source": "/en/neighbourhood/:code",
      "destination": "/en/neighbourhood"
    }
  ]
}
